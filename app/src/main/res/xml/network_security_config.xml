<?xml version="1.0" encoding="utf-8"?>
<!--
  Loopback only. Spotify OAuth redirects to http://127.0.0.1:…/login (Keymaster
  loopback), and the email-OTP SPA navigations sometimes miss
  shouldOverrideUrlLoading and then die on ERR_CLEARTEXT_NOT_PERMITTED unless
  loopback is allowlisted.

  Upstream phono also allowlisted tidal.com / tidalhifi.com for TIDAL's cleartext
  signed CDN URLs. Those are gone with the TIDAL backend, so cleartext is now
  permitted for nothing but the local redirect servers.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
