<?xml version="1.0" encoding="utf-8"?>
<!--
  A record, drawn in the LightOS idiom: white strokes, no fills, no gradients.

  Monochrome by construction rather than by conversion. The LPIII panel renders greyscale
  unless an app lifts the daltonizer, so a colour icon would arrive as mud; this one is
  already the two values the panel is good at. It also means the same vector serves as the
  API 33 monochrome layer with no second asset.

  Everything sits within r=33 of centre — the adaptive-icon safe zone — so a circular mask
  cannot clip the tonearm off, which is what happens if you draw one reaching for the corner.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Record edge. Heaviest stroke, so the silhouette survives a 48px list row. -->
    <path
        android:pathData="M24.0,54.0 a30,30 0 1,0 60,0 a30,30 0 1,0 -60,0"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5" />

    <!-- One groove. A single ring reads as a record; three read as a target. -->
    <path
        android:pathData="M33.0,54.0 a21,21 0 1,0 42,0 a21,21 0 1,0 -42,0"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2" />

    <!-- Label edge. -->
    <path
        android:pathData="M43.0,54.0 a11,11 0 1,0 22,0 a11,11 0 1,0 -22,0"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3" />

    <!-- Spindle hole. Filled, because at icon size a 2px ring disappears. -->
    <path
        android:pathData="M51.5,54.0 a2.5,2.5 0 1,0 5.0,0 a2.5,2.5 0 1,0 -5.0,0"
        android:fillColor="#FFFFFF" />
</vector>
