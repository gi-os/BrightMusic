<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      Draws the playback row on LightOS's lock screen, which has no media hook of its own. LightOS
      exposes no Settings UI for this, so it is an adb appop grant:
        adb shell appops set com.lightphone.spotify SYSTEM_ALERT_WINDOW allow
      Ungranted, `Settings.canDrawOverlays` is false and the feature never runs.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
      The sleep timer. It has to fire with the screen off and the phone in Doze, which only an
      allow-while-idle alarm does, and it has to be on time — a sleep timer a quarter of an hour
      late is not one. USE_EXACT_ALARM is granted at install (minSdk 33) and is meant for exactly
      this: an alarm the user set to a wall-clock length. SleepTimer still checks
      canScheduleExactAlarms() and falls back to the inexact call rather than throwing.
    -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!--
      Reading paired-device names for the Output screen. Runtime permission (minSdk 33, so no
      legacy BLUETOOTH/BLUETOOTH_ADMIN variants needed). Without it the screen still lists live
      audio outputs and can switch between them — only the paired-but-idle names are hidden.
      Note there is no permission that would let an app CONNECT a device: BLUETOOTH_PRIVILEGED is
      signature|privileged, so unlike WRITE_SECURE_SETTINGS it is not an adb grant away.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!--
      Album art in real colour. The LPIII panel is a full-colour AMOLED; LightOS pins
      Android's daltonizer to monochromacy, and clearing that setting while a cover is on
      screen shows true colour (see ui/light/ColorMode.kt).

      signature|privileged|development, so it is never granted by installing — it needs a
      one-time adb grant:
        adb shell pm grant com.lightphone.spotify android.permission.WRITE_SECURE_SETTINGS
      Without it the app degrades to greyscale covers instead of failing.
    -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Phono">

        <!--

          What you listened to on a day, read-only, for LightNotebook's journal. This app is the only

          thing that knows it; nothing here needs a history of its own. See PlayHistoryProvider.

        -->

        <provider

            android:name=".history.PlayHistoryProvider"

            android:authorities="com.lightphone.spotify.plays"

            android:exported="true" />


        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Phono.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Spotify Step 1 loopback redirect fallback (WebView + local server). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="http"
                    android:host="127.0.0.1"
                    android:port="8898"
                    android:path="/login" />
            </intent-filter>
        </activity>

        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:stopWithTask="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- Offline downloads (Spotify FGS; the Media3 TIDAL service is gone). -->
        <!-- Daily podcast check. Not exported: only our own alarm triggers it. -->
        <receiver
            android:name=".podcast.PodcastAlarmReceiver"
            android:exported="false" />

        <!-- Sleep timer expiry. Same deal: our own alarm, nobody else's. -->
        <receiver
            android:name=".playback.SleepTimerReceiver"
            android:exported="false" />

        <service
            android:name=".playback.download.SpotifyDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
            LightSync finds apps by provider authority suffix, so this entry is the whole
            registration. exported=true is required for a cross-app ContentProvider and is not
            the trust boundary: LightSyncBackup rejects any caller that is not LightSync by
            package and by signing certificate, checked on every call.
        -->
        <provider
            android:name=".backup.Backup"
            android:authorities="${applicationId}.lightsync.backup"
            android:exported="true" />

    </application>
</manifest>
